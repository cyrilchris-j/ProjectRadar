# ─── SUPABASE ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── DATABASE (direct connection for backend) ─────────────────────────────────
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── AUTH ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ─── FILE STORAGE ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
# Options: local | supabase
LOCAL_STORAGE_PATH=./storage
SUPABASE_STORAGE_BUCKET=paimana-documents

# ─── FRONTEND ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEVER put service-role key here

# ─── APP ─────────────────────────────────────────────────────────────────────
APP_NAME=PAIMANA Intelligence Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
# Options: development | staging | production

# ─── ML ──────────────────────────────────────────────────────────────────────
ML_ENABLED=false
ML_MIN_TRAINING_PROJECTS=50
ML_MIN_SNAPSHOTS_PER_PROJECT=3
MODEL_STORAGE_PATH=./app/ml/models

# ─── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
